  "cards": [
    {
      "dot": "cyan",
      "title": "Primary Path",
      "items": [
        "Scheduler calls collect_* stages; the HTTP client validates Tiingo payloads",
        "Canonical DataFrames reach System PostgreSQL via writer callback + upsert_*",
        "Scheduler snapshots PostgreSQL to Parquet for Spaces and Managed PostgreSQL"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust + Failure Controls",
      "items": [
        "Tiingo is untrusted; SyncFailure carries a category, is_quota_failure isolates quota",
        "Secrets come from the environment; migrations hold an advisory lock and fail closed",
        "Since 4.2.0 close_duckdb raises on a normal return path"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ownership + Deployment",
      "items": [
        "Library: collection, normalization, PostgreSQL, Parquet, DuckDB primitives",
        "Scheduler: cron, split retries, Spaces, rolling three-year Managed PostgreSQL",
        "Production loads the Pkg cache pinned by the scheduler rev v4.2.1, never /opt/tiingojulia"
      ]
    }
  ]
